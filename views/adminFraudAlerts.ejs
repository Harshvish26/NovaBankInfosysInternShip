<%- include('partials/header', { 
    title: 'Fraud Alerts', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

<main class="container mx-auto px-4 py-8">
    
    <div class="flex justify-between items-center mb-6">
        
        <h1 class="text-3xl font-extrabold text-gray-900 flex items-center">
            <i class="fas fa-shield-alt mr-3 text-red-600"></i> <%= title %>
        </h1>
        
        <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium inline-flex items-center p-2 rounded-lg bg-gray-50 hover:bg-gray-100 transition duration-150 ease-in-out">
            <i class="fas fa-arrow-left mr-2"></i><- Back To Dashboard
        </a>
    </div>
    
    <p class="text-gray-600 mb-8">Critical alerts requiring immediate administrative attention (Simulated: Transactions over ₹50,000).</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <% if (alerts && alerts.length > 0) { %>
            <div class="space-y-4">
                <% alerts.forEach(alert => { %>
                    <div class="p-4 bg-red-50 border border-red-400 rounded-lg flex flex-col sm:flex-row justify-between items-start sm:items-center transition duration-200 hover:shadow-md">
                        <div class="mb-3 sm:mb-0">
                            <p class="font-bold text-red-800 text-lg"><%= alert.type %></p>
                            <p class="text-sm text-gray-700 mt-1">
                                User A/C: <span class="font-mono bg-red-100 px-1 rounded"><%= alert.user %></span> | 
                                Amount: <span class="font-extrabold text-red-600">₹<%= alert.amount.toLocaleString() %></span> 
                            </p>
                            <p class="text-xs text-gray-500 mt-1">Reported: <%= alert.date.toLocaleString() %></p>
                        </div>
                        
                        <a href="/admin/view-user/<%= alert.id %>" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition w-full sm:w-auto text-center">
                             <i class="fas fa-search mr-1"></i> Investigate / Block
                        </a>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="text-gray-600 p-4 bg-green-50 rounded-lg border border-green-300 text-center flex items-center justify-center font-medium">
                 <i class="fas fa-check-circle text-green-600 mr-2"></i> No critical fraud alerts at this time. System is secure.
            </p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>