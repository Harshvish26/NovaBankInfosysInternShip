<%- include('partials/header', { 
    title: 'Fraud Alerts', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<main>

    <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium mb-5 inline-flex items-center">
        <i class="fas fa-arrow-left mr-2"></i>← Back to Dashboard
    </a>
    
    <h1 class="text-3xl font-extrabold text-gray-900 mb-6 flex items-center">
        <i class="fas fa-shield-alt mr-3 text-blue-600"></i> <%= title %>
    </h1>
    
    <p class="text-gray-600 mb-8">Critical alerts requiring immediate administrative attention (Simulated).</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <% if (alerts && alerts.length > 0) { %>
            <div class="space-y-4">
                <% alerts.forEach(alert => { %>
                    <div class="p-4 bg-red-50 border border-red-400 rounded-lg flex justify-between items-center">
                        <div>
                            <p class="font-semibold text-red-700 text-lg"><%= alert.type %></p>
                            <p class="text-sm text-gray-600">User A/C: <span class="font-mono"><%= alert.user %></span> | Amount: <%= alert.amount %> </p>
                            <p class="text-xs text-gray-500 mt-1">Reported: <%= alert.date.toLocaleString() %></p>
                        </div>
                        <button class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                            Investigate / Block
                        </button>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p class="text-gray-500 p-4 bg-green-50 rounded-lg border border-green-200 text-center">No critical fraud alerts at this time. System is secure.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>