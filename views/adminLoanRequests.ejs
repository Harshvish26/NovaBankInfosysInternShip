<%- include('partials/header', { 
    title: 'Loan Requests', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

<main class="container mx-auto px-4 py-8">
    
    <div class="flex justify-between items-center mb-6">
        
        <h1 class="text-3xl font-extrabold text-gray-900 flex items-center">
            <i class="fas fa-dollar-sign mr-3 text-green-600"></i> <%= title %>
        </h1>
        
        <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium inline-flex items-center p-2 rounded-lg bg-gray-50 hover:bg-gray-100 transition duration-150 ease-in-out">
            <i class="fas fa-arrow-left mr-2"></i><- Back To Dashboard
        </a>
    </div>
    
    <p class="text-gray-600 mb-8">Review and manage all incoming loan requests from registered users.</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <% if (loans && loans.length > 0) { %>
            <% 
                const pendingLoans = loans.filter(loan => loan.status === 'Pending');
                const otherLoans = loans.filter(loan => loan.status !== 'Pending');
                const prioritizedLoans = [...pendingLoans, ...otherLoans];
            %>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-blue-50/50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Loan ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">User A/C</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase tracking-wider">Amount (₹)</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Reason</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% prioritizedLoans.forEach(loan => { 
                            const statusColor = loan.status === 'Approved' ? 'text-green-600 bg-green-100' : 
                                                (loan.status === 'Pending' ? 'text-yellow-700 bg-yellow-100 font-bold' : 'text-red-600 bg-red-100');
                        %>
                        <tr class="<%= loan.status === 'Pending' ? 'bg-yellow-50/50' : 'hover:bg-blue-50/20' %>">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= loan.id %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= loan.accountNumber %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-extrabold text-right text-indigo-700">₹ <%= loan.amount.toLocaleString('en-IN') %></td>
                            <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate"><%= loan.reason %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-xs font-semibold">
                                <span class="px-2 inline-flex leading-5 rounded-full <%= statusColor %>">
                                    <%= loan.status %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm flex gap-2 justify-end">
                                <% if (loan.status === 'Pending') { %>
                                    <form method="POST" action="/admin/loan-request/approve/<%= loan.id %>" onsubmit="return confirm('Are you sure you want to APPROVE loan ID <%= loan.id %>?');">
                                        <button type="submit" class="text-white px-3 py-1 bg-green-600 rounded-lg hover:bg-green-700 transition font-semibold">Approve</button>
                                    </form>
                                    <form method="POST" action="/admin/loan-request/reject/<%= loan.id %>" onsubmit="return confirm('Are you sure you want to REJECT loan ID <%= loan.id %>?');">
                                        <button type="submit" class="text-white px-3 py-1 bg-red-600 rounded-lg hover:bg-red-700 transition font-semibold">Reject</button>
                                    </form>
                                <% } else { %>
                                    <a href="#" class="px-3 py-1 border rounded-lg border-gray-300 text-gray-500 text-xs hover:bg-gray-100">View Details</a>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-600 p-4 bg-blue-50 rounded-lg border border-blue-200 text-center flex items-center justify-center font-medium">
                <i class="fas fa-info-circle text-blue-600 mr-2"></i> No outstanding loan requests found. All clear!
            </p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>