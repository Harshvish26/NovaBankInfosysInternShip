<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Bank - Admin Login</title>
    <!-- Assuming Tailwind is loaded in partials/header.ejs or via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Poppins Font (for a modern look) */
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8f8fb; /* Light background for contrast */
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <!-- 🚀 Modernized Admin Login Form Section -->
    <main class="flex justify-center items-center py-12 md:py-20 min-h-screen">
        <form method="POST" action="/admin/login" class="bg-white text-gray-500 max-w-sm w-full mx-4 p-8 md:p-10 text-sm rounded-xl shadow-[0px_0px_25px_0px] shadow-gray-200/50">
            <h2 class="text-3xl font-bold mb-8 text-center text-gray-800">Admin Login</h2>
            
            <!-- Error Message Display -->
            <% if (error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-center" role="alert">
                    <p><%= error %></p>
                </div>
            <% } %>

            <div class="space-y-4">

                <!-- 1. Admin Email -->
                <div class="flex items-center border bg-gray-100/50 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-gray-500 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user-check"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
                    <input class="w-full outline-none bg-transparent py-3 text-gray-800" type="email" name="email" placeholder="Admin Email" required>
                </div>

                <!-- 2. Password -->
                <div class="flex items-center border bg-gray-100/50 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-gray-500 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-lock"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <input class="w-full outline-none bg-transparent py-3 text-gray-800" type="password" name="password" placeholder="Password" required>
                </div>
            </div>

            <div class="mt-8">
                <!-- Submit Button -->
                <button type="submit" class="w-full mb-3 bg-gray-700 hover:bg-gray-800 transition-all active:scale-95 py-3 rounded-lg text-white font-semibold shadow-md shadow-gray-400/50">
                    Login as Admin
                </button>
                <p class="text-center text-gray-600 mt-4">
                    <a href="/login" class="text-indigo-600 hover:text-indigo-800 font-medium underline transition">Go to User Login</a>
                </p>
            </div>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>