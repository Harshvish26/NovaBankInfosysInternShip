<%- include('partials/header', { 
    title: 'Financial Reports', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

<main class="container mx-auto px-4 py-8">

    <div class="flex justify-between items-center mb-6">
        
        <h1 class="text-3xl font-extrabold text-gray-900 flex items-center">
            <i class="fas fa-file-pdf mr-3 text-red-600"></i> <%= title %>
        </h1>
        
        <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium inline-flex items-center p-2 rounded-lg bg-gray-50 hover:bg-gray-100 transition duration-150 ease-in-out">
            <i class="fas fa-arrow-left mr-2"></i><- Back To Dashboard
        </a>
    </div>
    
    <p class="text-gray-600 mb-8">Generate and view key reports for regulatory and operational analysis.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        
        <div class="bg-white p-6 rounded-xl shadow-lg border-l-4 border-indigo-600 hover:shadow-xl transition duration-300">
            <p class="text-sm font-medium text-gray-500 uppercase">Transactions in <%= currentMonth || 'This Month' %></p>
            <p class="text-4xl font-extrabold text-indigo-700 mt-2">
                <%= monthlyTxs || 0 %>
            </p>
            <p class="text-xs text-gray-400 mt-2">Count of all transactions since month start.</p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg border-l-4 border-green-600 hover:shadow-xl transition duration-300">
            <p class="text-sm font-medium text-gray-500 uppercase">Total Deposits Count (All Time)</p>
            <p class="text-4xl font-extrabold text-green-700 mt-2">
                <%= totalDeposits || 0 %>
            </p>
            <p class="text-xs text-gray-400 mt-2">Total number of 'deposit' transactions recorded.</p>
        </div>
        
        <div class="bg-gray-50 p-6 rounded-xl shadow-lg border border-gray-200 flex flex-col justify-between hover:shadow-xl transition duration-300">
            <p class="text-lg font-bold text-gray-800">Generate Full Report</p>
            <p class="text-sm text-gray-600 mb-3">Download comprehensive system data for the current period.</p>
            <button class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold flex items-center justify-center">
                <i class="fas fa-download mr-2"></i>
                <a href="/admin/download-system-report" class="btn btn-primary">
                    Generate & Download PDF
                </a>
            </button>
            </div>
    </div>
    
    <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
        <h3 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
            <i class="fas fa-history mr-2 text-gray-500"></i> Past Reports Archive
        </h3>
        <ul class="list-disc list-inside text-gray-600 space-y-2 ml-4">
            <li><a href="#" class="text-blue-600 hover:underline">Q3 2025 Financial Overview (PDF)</a></li>
            <li><a href="#" class="text-blue-600 hover:underline"><%= currentMonth %> Transaction Summary (CSV)</a></li>
            <li><a href="#" class="text-blue-600 hover:underline">Last Year's Annual Compliance Report (PDF)</a></li>
        </ul>
    </div>

</main>
<%- include('partials/footer') %>