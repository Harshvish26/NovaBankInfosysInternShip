<%- include('partials/header', { 
    title: 'Reports', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<main>

    <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium mb-5 inline-flex items-center">
        <i class="fas fa-arrow-left mr-2"></i>← Back to Dashboard
    </a>

    <h1 class="text-3xl font-extrabold text-gray-900 mb-6 flex items-center">
        <i class="fas fa-file-pdf mr-3 text-blue-600"></i> <%= title %>
    </h1>
    
    <p class="text-gray-600 mb-8">Generate and view key reports for regulatory and operational analysis.</p>

    <!-- Report Metrics (Assuming monthlyTxs, totalDeposits, currentMonth are passed) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        
        <div class="bg-white p-6 rounded-xl shadow-lg border-l-4 border-indigo-600">
            <p class="text-sm font-medium text-gray-500 uppercase">Transactions in <%= currentMonth || 'This Month' %></p>
            <p class="text-3xl font-extrabold text-indigo-700 mt-1">
                <%= monthlyTxs || 0 %>
            </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg border-l-4 border-green-600">
            <p class="text-sm font-medium text-gray-500 uppercase">Total Deposits Count (All Time)</p>
            <p class="text-3xl font-extrabold text-green-700 mt-1">
                <%= totalDeposits || 0 %>
            </p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-lg border-l-4 border-gray-600 flex flex-col justify-between">
            <p class="text-lg font-semibold text-gray-700">Generate Full Report</p>
            <button class="w-full mt-3 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                Generate & Download PDF
            </button>
        </div>
    </div>
    
    <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Past Reports Archive</h3>
        <p class="text-gray-500">List of archived monthly/quarterly reports will appear here.</p>
    </div>

</main>
<%- include('partials/footer') %>