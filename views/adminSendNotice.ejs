<%- include('partials/header', { 
    title: 'Send Notice', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

<main class="container mx-auto px-4 py-8">
    
    <div class="flex justify-between items-center mb-6">
        
        <h1 class="text-3xl font-extrabold text-gray-900 flex items-center">
            <i class="fas fa-envelope-open-text mr-3 text-red-600"></i> <%= title %>
        </h1>
        
        <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium inline-flex items-center p-2 rounded-lg bg-gray-50 hover:bg-gray-100 transition duration-150 ease-in-out">
            <i class="fas fa-arrow-left mr-2"></i><- Back To Dashboard
        </a>
    </div>
    
    <p class="text-gray-600 mb-8">Send mass communications or specific notices to users via email (Simulated).</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-2xl border border-gray-100 max-w-3xl mx-auto">
        <form action="/admin/send-notice" method="POST" class="space-y-6">
            
            <div class="form-group">
                <label for="recipient" class="block text-sm font-bold text-gray-700 mb-1">Recipient Type:</label>
                <select name="recipient" id="recipient" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 bg-gray-50">
                    <option value="all">All Users (Mass Notice)</option>
                    <option value="specific">Specific User (Enter Email/A/C below)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="email_ac" class="block text-sm font-bold text-gray-700 mb-1">Specific Recipient (Optional Email/A/C):</label>
                <input type="text" name="email_ac" id="email_ac" placeholder="user@example.com or A/C number (Only used if 'Specific User' is selected)" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition duration-150">
            </div>

            <div class="form-group">
                <label for="subject" class="block text-sm font-bold text-gray-700 mb-1">Subject / Title:</label>
                <input type="text" name="subject" id="subject" required placeholder="Important Security Update" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition duration-150">
            </div>
            
            <div class="form-group">
                <label for="body" class="block text-sm font-bold text-gray-700 mb-1">Email Body / Notice Content:</label>
                <textarea name="body" id="body" rows="8" required placeholder="Write your full message here..." class="w-full p-3 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition duration-150"></textarea>
            </div>
            
            <button type="submit" class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-extrabold flex items-center justify-center shadow-lg hover:shadow-xl">
                 <i class="fas fa-paper-plane mr-2"></i> Send Communication
            </button>
        </form>
    </div>
</main>
<%- include('partials/footer') %>