<%- include('partials/header', { 
    title: 'System Logs', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<main>

    <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium mb-5 inline-flex items-center">
        <i class="fas fa-arrow-left mr-2"></i>← Back to Dashboard
    </a>

    <h1 class="text-3xl font-extrabold text-gray-900 mb-6 flex items-center">
        <i class="fas fa-bug mr-3 text-blue-600"></i> <%= title %>
    </h1>
    
    <p class="text-gray-600 mb-8">View system logs for debugging, security auditing, and monitoring purposes (Simulated).</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Latest Log Entries</h3>
        <div class="overflow-y-auto max-h-[60vh] bg-gray-900 text-white p-4 rounded-lg font-mono text-sm">
            <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { 
                    const color = log.level === 'ERROR' ? 'text-red-500' : (log.level === 'WARNING' ? 'text-yellow-500' : 'text-green-500');
                %>
                    <div class="border-b border-gray-800 pb-2 mb-2">
                        <span class="text-gray-400 mr-2"><%= log.time %></span>
                        <span class="font-bold <%= color %> mr-3"><%= log.level %>:</span>
                        <span><%= log.message %></span>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-gray-500">No recent logs available.</p>
            <% } %>
        </div>
    </div>
</main>
<%- include('partials/footer') %>