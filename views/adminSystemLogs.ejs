<%- include('partials/header', { 
    title: 'System Logs', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

<main class="container mx-auto px-4 py-8">

    <div class="flex justify-between items-center mb-6">
        
        <h1 class="text-3xl font-extrabold text-gray-900 flex items-center">
            <i class="fas fa-bug mr-3 text-red-600"></i> <%= title %>
        </h1>
        
        <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium inline-flex items-center p-2 rounded-lg bg-gray-50 hover:bg-gray-100 transition duration-150 ease-in-out">
            <i class="fas fa-arrow-left mr-2"></i><- Back To Dashboard
        </a>
    </div>
    
    <p class="text-gray-600 mb-8">View system logs for debugging, security auditing, and monitoring purposes (Simulated).</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <h3 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
            <i class="fas fa-list-alt mr-2 text-gray-500"></i> Latest Log Entries
        </h3>
        
        <div class="overflow-y-auto max-h-[60vh] bg-gray-900 text-white p-4 rounded-lg font-mono text-sm border border-gray-700">
            <% if (logs && logs.length > 0) { %>
                <div class="space-y-2">
                    <% logs.forEach(log => { 
                        // Determine color based on log level
                        const color = log.level === 'ERROR' ? 'text-red-500' : 
                                      (log.level === 'WARNING' ? 'text-yellow-500' : 'text-green-500');
                    %>
                        <div class="pb-1 hover:bg-gray-800/50 transition duration-100">
                            <span class="text-gray-400 mr-2 whitespace-nowrap"><%= log.time %></span>
                            <span class="font-bold <%= color %> mr-3 whitespace-nowrap"><%= log.level %>:</span>
                            <span class="break-words block sm:inline-block pl-10 sm:pl-0"><%= log.message %></span>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="text-gray-500 text-center py-4">No recent logs available.</p>
            <% } %>
        </div>
        
        <p class="text-xs text-gray-500 mt-4">Note: Logs are currently simulated/limited to recent entries. Full log access requires backend file system integration.</p>
    </div>
</main>
<%- include('partials/footer') %>