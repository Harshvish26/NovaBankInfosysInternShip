<%- include('partials/header', { 
    title: 'Account Upgrades', 
    session: session, 
    error: typeof error !== 'undefined' ? error : null, 
    message: typeof message !== 'undefined' ? message : null 
}) %>

<main>

    <a href="/admin/dashboard" class="text-blue-600 hover:text-blue-800 font-medium mb-5 inline-flex items-center">
        <i class="fas fa-arrow-left mr-2"></i>← Back to Dashboard
    </a>

    <h1 class="text-3xl font-extrabold text-gray-900 mb-6 flex items-center">
        <i class="fas fa-crown mr-3 text-blue-600"></i> <%= title %>
    </h1>
    
    <p class="text-gray-600 mb-8">Review and manage users eligible for premium/VIP account upgrades (Simulated).</p>

    <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Eligible Users (Balance > ₹ 1,00,000)</h3>
        <% if (eligibleUsers && eligibleUsers.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-blue-50/50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Account Number</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase tracking-wider">Balance (₹)</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% eligibleUsers.forEach(u => { %>
                        <tr class="hover:bg-blue-50/20">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= u.name %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= u.accountNumber %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-right text-green-600">₹ <%= u.balance.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                                <button class="px-3 py-1.5 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition">Offer VIP Upgrade</button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-500 p-4 bg-gray-50 rounded-lg border border-gray-200 text-center">No users currently eligible for an upgrade.</p>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>