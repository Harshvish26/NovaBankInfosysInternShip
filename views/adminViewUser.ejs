<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - User: <%= user.name %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Poppins', sans-serif; background: #f8f8fb; }
        .tx-deposit { color: #10B981; }
        .tx-withdraw { color: #F59E0B; }
        .tx-transfer { color: #3B82F6; }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto px-4 md:px-8 py-10">
        <div class="flex justify-between items-center mb-6 border-b pb-2">
            <h2 class="text-3xl font-extrabold text-gray-900">User Details: <%= user.name %></h2>
            <a href="/admin/dashboard" class="text-indigo-600 hover:text-indigo-800 font-medium">← Back to Admin Dashboard</a>
        </div>

        <!-- User Summary -->
        <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div><p class="text-xs text-gray-500">Account Holder</p><p class="font-bold text-gray-800"><%= user.name %></p></div>
            <div><p class="text-xs text-gray-500">Account Number</p><p class="font-bold text-indigo-600"><%= user.accountNumber %></p></div>
            <div><p class="text-xs text-gray-500">Email</p><p class="font-bold text-gray-800"><%= user.email %></p></div>
            <div><p class="text-xs text-gray-500">City / Mobile</p><p class="font-bold text-gray-800"><%= user.city %> / <%= user.mobile || 'N/A' %></p></div>
            <div class="md:col-span-3 p-3 bg-green-50 rounded-lg">
                <p class="text-sm text-gray-600 font-medium">Current Balance</p>
                <p class="text-3xl font-extrabold text-green-700">₹ <%= user.balance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
            </div>
        </div>

        <!-- Full Transaction History -->
        <section class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
            <h3 class="text-2xl font-semibold text-gray-800 mb-6">Full Transaction History</h3>
            
            <% if (txs.length === 0) { %>
                <p class="text-gray-500">No transactions recorded yet.</p>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount (₹)</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% txs.forEach(tx => { 
                                const isDebit = tx.fromAccount === user.accountNumber;
                                const detailText = isDebit 
                                    ? `Sent to A/C ${tx.toAccount}` 
                                    : (tx.fromAccount === 'bank' ? 'Deposit' : `Received from A/C ${tx.fromAccount}`);
                            %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                                        <%= tx.createdAt.toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium capitalize <%= isDebit ? 'text-red-600' : 'text-green-600' %>">
                                        <%= isDebit ? 'Debit' : 'Credit' %> (<%= tx.type %>)
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <%= detailText %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-right <%= isDebit ? 'text-red-600' : 'text-green-600' %>">
                                        <%= isDebit ? '-' : '+' %> 
                                        <%= tx.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
    <%- include('partials/footer') %>
</body>
</html>