<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Bank - Verify OTP</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8f8fb;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <!-- 🚀 Modernized OTP Form Section -->
    <main class="flex justify-center items-center py-12 md:py-20 min-h-screen pt-20">
        <form method="POST" action="/otp" class="bg-white text-gray-500 max-w-sm w-full mx-4 p-8 md:p-10 text-sm rounded-xl shadow-[0px_0px_25px_0px] shadow-indigo-100/50">
            <h2 class="text-3xl font-bold mb-4 text-center text-gray-800">Verify OTP</h2>
            <p class="text-center text-gray-500 mb-8">A 6-digit code has been sent to your registered email.</p>
            
            <% if (error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-center" role="alert">
                    <p><%= error %></p>
                </div>
            <% } %>

            <div class="space-y-4">
                <!-- OTP Input -->
                <div class="flex items-center border bg-indigo-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-indigo-400 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-lock"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <input class="w-full outline-none bg-transparent py-3 text-gray-800" type="number" name="otp" placeholder="Enter 6-digit OTP" required maxlength="6" minlength="6">
                </div>
            </div>

            <div class="mt-8">
                <!-- Submit Button -->
                <button type="submit" class="w-full mb-3 bg-indigo-600 hover:bg-indigo-700 transition-all active:scale-95 py-3 rounded-lg text-white font-semibold shadow-md shadow-indigo-200">
                    Verify & Login
                </button>
            </div>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>