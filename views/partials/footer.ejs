<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <!-- --- Attractive Footer Section --- -->
    <footer
      class="bg-white text-gray-800 w-full mt-16 py-10 border-t border-gray-200 shadow-xl"
    >
      <div class="px-6 md:px-16 lg:px-24 xl:px-32 max-w-7xl mx-auto">
        <div
          class="flex flex-col md:flex-row items-start justify-between gap-10 py-5 border-b border-gray-300"
        >
          <div class="max-w-96 md:w-1/3">
            <!-- Branding with SVG Logo (Used 'currentColor' for theme integration) -->
            <a
              href="/"
              class="flex items-center gap-2 text-indigo-700 hover:text-indigo-800 transition"
            >
              <!-- 💡 SVG LOGO (M-shaped, representing Growth and Modernity) -->
              <svg
                width="32"
                height="32"
                viewBox="0 0 100 100"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="flex-shrink-0"
              >
                <!-- Background M Shape (using two large segments for clean 'N' effect) -->
                <path
                  d="M5 95 L5 10 L50 90 L95 10 L95 90"
                  stroke="#4F46E5"
                  stroke-width="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <!-- Accent Dot (Represents Nova/Digital focus) -->
                <circle cx="50" cy="25" r="8" fill="#3B82F6" />
              </svg>

              <!-- Text Brand Name -->
              <span class="text-2xl font-extrabold text-indigo-700"
                >Nova Bank</span
              >
            </a>

            <p class="mt-6 text-sm text-gray-600">
              Nova Bank is committed to securing your future with robust and
              reliable digital banking solutions.
            </p>
            <div class="flex items-center gap-4 mt-4 text-indigo-600">
              <!-- Social Icons (Using user provided SVGs) -->
              <a href="#" class="hover:text-indigo-800 transition">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M19.167 2.5a9.1 9.1 0 0 1-2.617 1.275 3.733 3.733 0 0 0-6.55 2.5v.833a8.88 8.88 0 0 1-7.5-3.775s-3.333 7.5 4.167 10.833a9.7 9.7 0 0 1-5.834 1.667C8.333 20 17.5 15.833 17.5 6.25q0-.35-.067-.692A6.43 6.43 0 0 0 19.167 2.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a href="#" class="hover:text-indigo-800 transition">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M7.5 15.833c-4.167 1.25-4.167-2.084-5.833-2.5m11.666 5v-3.225a2.8 2.8 0 0 0-.783-2.175c2.616-.292 5.366-1.283 5.366-5.833a4.53 4.53 0 0 0-1.25-3.125 4.22 4.22 0 0 0-.075-3.142s-.983-.292-3.258 1.233a11.15 11.15 0 0 0-5.833 0C5.225.541 4.242.833 4.242.833a4.22 4.22 0 0 0-.075 3.142 4.53 4.53 0 0 0-1.25 3.15c0 4.516 2.75 5.508 5.366 5.833a2.8 2.8 0 0 0-.783 2.15v3.225"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a href="#" class="hover:text-indigo-800 transition">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M13.333 6.667a5 5 0 0 1 5 5V17.5H15v-5.833a1.667 1.667 0 0 0-3.334 0V17.5H8.333v-5.833a5 5 0 0 1 5-5M5 7.5H1.667v10H5zM3.333 5a1.667 1.667 0 1 0 0-3.333 1.667 1.667 0 0 0 0 3.333"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>

          <div
            class="w-full md:w-1/3 flex flex-wrap justify-between md:flex-nowrap gap-10"
          >
            <div>
              <h2 class="font-semibold text-gray-900 mb-5 text-sm uppercase">
                Resources
              </h2>
              <ul class="text-sm text-gray-600 space-y-2 list-none p-0">
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Documentation</a
                  >
                </li>
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Tutorials</a
                  >
                </li>
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Security Blog</a
                  >
                </li>
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Community</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <h2 class="font-semibold text-gray-900 mb-5 text-sm uppercase">
                Company
              </h2>
              <ul class="text-sm text-gray-600 space-y-2 list-none p-0">
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >About Us</a
                  >
                </li>
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Careers</a
                  >
                </li>
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Privacy Policy</a
                  >
                </li>
                <li>
                  <a href="#" class="hover:text-indigo-600 transition"
                    >Terms & Conditions</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
        <p class="py-4 text-center text-xs md:text-sm text-gray-500">
          Copyright <%= new Date().getFullYear() %> ©
          <span class="font-medium text-indigo-600">Nova Bank</span>. All Rights
          Reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
