<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Bank - Change PIN</title>

    <link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
        body { font-family: 'Poppins', sans-serif; background: #f8f8fb; }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main class="max-w-md mx-auto px-4 md:px-8 py-10">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6 border-b pb-2">Change Banking PIN</h2>
        
        <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6" role="alert">
                <p class="font-medium"><%= error %></p>
            </div>
        <% } %>

        <!-- Step 1: Request OTP -->
        <% if (step === 1) { %>
            <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-pink-500">
                <p class="text-gray-600 mb-6">We will send an OTP to your registered email (<%= user.email %>) to verify your request.</p>
                <form method="POST" action="/user/change-pin-otp">
                    <button type="submit" class="w-full bg-pink-600 hover:bg-pink-700 text-white font-semibold py-3 rounded-lg transition shadow-md shadow-pink-200">
                        Send OTP for Verification
                    </button>
                </form>
            </div>

        <!-- Step 2: Verify OTP and Set New PIN -->
        <% } else if (step === 2) { %>
            <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-pink-500">
                <p class="text-gray-600 mb-4">OTP has been sent. Enter the code and set your new PIN.</p>
                <form method="POST" action="/user/set-new-pin" class="space-y-4">
                    
                    <!-- OTP Input -->
                    <div class="flex items-center border bg-pink-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-pink-400 transition">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-mail"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <input name="otp" type="number" maxlength="6" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="Enter 6-digit OTP" required />
                    </div>

                    <!-- New PIN Input -->
                    <div class="flex items-center border bg-pink-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-pink-400 transition">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-lock"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <input name="newPin" type="password" maxlength="6" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="Set New 4-6 digit PIN" required />
                    </div>
                    
                    <div class="pt-2">
                        <button type="submit" class="w-full bg-pink-600 hover:bg-pink-700 text-white font-semibold py-3 rounded-lg transition shadow-md shadow-pink-200">
                            Set New PIN
                        </button>
                    </div>
                </form>
            </div>
        <% } %>
        
        <div class="mt-8 text-center">
            <a href="/user/dashboard" class="text-indigo-600 hover:text-indigo-800 font-medium">← Back to Dashboard</a>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>