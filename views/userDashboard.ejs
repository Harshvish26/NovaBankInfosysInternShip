<!DOCTYPE html>
<html>
<%- include('partials/header', { title: 'Dashboard', session: session, error: error, message: message }) %>

<main>
    
    <!-- --- Main Dashboard Grid Layout --- -->
    <div class="flex flex-col lg:flex-row gap-8 mt-3">
        
        <!-- Left Column: Quick Actions & Navigation (Vertical Services) -->
        <div class="w-full lg:w-1/4">
            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b border-indigo-200 pb-2">Quick Services</h3>
            
            <!-- Dynamic Vertical Action Links (using JavaScript for a clean structure) -->
            <div id="vertical-services" class="space-y-3">
                <!-- Links will be injected here -->
            </div>
            
            <!-- Danger Zone link (outside injection for visibility) -->
            <a href="#" onclick="document.getElementById('close-modal').classList.remove('hidden'); return false;" class="block mt-6 px-4 py-3 bg-red-50 text-red-600 border border-red-400 rounded-xl font-medium hover:bg-red-100 transition shadow-sm">
                <i class="fas fa-exclamation-triangle mr-2"></i> Close Account Zone
            </a>
        </div>

        <!-- Right Column: Main Content (Balance, Messages, Mini Statement) -->
        <div class="w-full lg:w-3/4">

            <!-- Welcome & Balance Card -->
            <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100 mb-8">
                <h2 class="text-3xl font-extrabold text-gray-900 mb-2">Welcome, <%= user.name %>!</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                    
                    <!-- Current Balance Display -->
                    <div class="p-5 bg-indigo-50 rounded-xl border-l-4 border-indigo-600 shadow-md">
                        <p class="text-lg text-gray-600 font-medium flex items-center mb-1">
                            <i class="fas fa-wallet text-xl text-indigo-600 mr-2"></i> Current Balance
                        </p>
                        <p class="text-4xl font-extrabold text-indigo-700">
                            ₹ <%= user.balance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </p>
                    </div>

                    <!-- Account Info Card -->
                    <div class="p-5 bg-gray-50 rounded-xl border-l-4 border-gray-400 shadow-md">
                         <p class="text-lg text-gray-600 font-medium mb-1">
                            <i class="fas fa-id-card text-xl text-gray-600 mr-2"></i> Account Details
                        </p>
                        <p class="text-xl font-bold text-gray-800">
                            A/C: <%= user.accountNumber %>
                        </p>
                        <p class="text-sm text-gray-500 mt-1">City: <%= user.city %></p>
                    </div>
                </div>
            </div>
            
            <!-- Mini Statement (Latest Transactions) -->
            <section class="bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-semibold text-gray-800 flex items-center">
                        <i class="fas fa-receipt text-indigo-600 mr-3"></i> Recent Transactions (Mini Statement)
                    </h3>
                    <a href="/user/history" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm transition">View Full History</a>
                </div>
                
                <% if (txs && txs.length === 0) { %>
                    <p class="text-gray-500 p-4 bg-gray-50 rounded-lg border border-gray-200 text-center">No recent transactions recorded.</p>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-indigo-50/50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Type</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Details</th>
                                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase tracking-wider">Amount (₹)</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase tracking-wider">Date</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% txs.forEach(tx => { %>
                                    <tr class="hover:bg-indigo-50/20 transition">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium capitalize 
                                            <% if (tx.type === 'deposit') { %>tx-deposit<% } else if (tx.type === 'withdraw') { %>tx-withdraw<% } else if (tx.type === 'transfer') { %>tx-transfer<% } %>">
                                            <% if (tx.type === 'deposit') { %>Deposit<% } else if (tx.type === 'withdraw') { %>Withdrawal<% } else if (tx.type === 'transfer') { %>Transfer<% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                            <%= tx.fromAccount === user.accountNumber ? 'To: ' + tx.toAccount : 'From: ' + tx.fromAccount %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-right 
                                            <%= tx.fromAccount === user.accountNumber && tx.type !== 'deposit' ? 'text-red-600' : 'text-green-600' %>">
                                            <%= tx.fromAccount === user.accountNumber && tx.type !== 'deposit' ? '-' : '+' %> 
                                            <%= tx.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            <%= new Date(tx.createdAt).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>
        </div>

    </div> <!-- End of Main Dashboard Grid Layout -->
    
    <!-- Close Account Modal (Kept outside the grid) -->
    <div id="close-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl p-6 w-full max-w-sm">
            <h3 class="text-xl font-bold text-red-700 mb-4">Confirm Account Closure</h3>
            <p class="text-gray-600 mb-6">Enter your banking PIN to confirm permanent closure of your account.</p>
            
            <form method="POST" action="/user/close-account">
                <div class="flex items-center border bg-red-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-red-400 transition mb-6">
                    <i class="fas fa-key text-red-500 opacity-80"></i>
                    <input name="pin" type="password" maxlength="4" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="Enter 4-Digit PIN" required />
                </div>
                
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="document.getElementById('close-modal').classList.add('hidden')" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                        Close Account
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 💡 JAVASCRIPT FOR VERTICAL SERVICE LINKS INJECTION -->
    <script>
        // Helper function for rendering vertical links
        function renderVerticalLink(title, url, iconClass, colorClass) {
            return `
                <a href="${url}" class="flex items-center p-3 text-sm rounded-xl bg-white shadow-sm hover:shadow-md transition border border-gray-200 hover:border-indigo-400">
                    <i class="fas ${iconClass} ${colorClass} text-lg w-6 mr-3"></i>
                    <span class="text-gray-700 font-medium">${title}</span>
                </a>
            `;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('vertical-services');
            
            if (container) {
                const linksHtml = [
                    renderVerticalLink('Deposit Money', '/user/deposit', 'fa-arrow-circle-up', 'text-emerald-600'),
                    renderVerticalLink('Withdraw Money', '/user/withdraw', 'fa-arrow-circle-down', 'text-amber-600'),
                    renderVerticalLink('Transfer Funds', '/user/transfer', 'fa-exchange-alt', 'text-blue-600'),
                    renderVerticalLink('Full History', '/user/history', 'fa-history', 'text-purple-600'),
                    renderVerticalLink('Update Profile', '/user/profile', 'fa-user-edit', 'text-indigo-600'),
                    renderVerticalLink('Change PIN', '/user/change-pin', 'fa-key', 'text-pink-600'),
                    renderVerticalLink('Loan Request', '/user/loan-request', 'fa-hand-holding-usd', 'text-yellow-600'),
                    renderVerticalLink('Calculate Interest', '/user/calculate-interest', 'fa-percent', 'text-cyan-600'), 
                    renderVerticalLink('Download Report', '/user/download-report', 'fa-file-download', 'text-teal-600'),
                    renderVerticalLink('Help & Support', '/user/chat', 'fa-headset', 'text-violet-600'),
                    renderVerticalLink('Logout', '/logout', 'fa-sign-out-alt', 'text-gray-700'), 
                ];
                container.innerHTML = linksHtml.join('');
            }
        });
    </script>
</main>
<%- include('partials/footer') %>
</html>