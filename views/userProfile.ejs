<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Bank - Update Profile</title>

    <link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
        body { font-family: 'Poppins', sans-serif; background: #f8f8fb; }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main class="max-w-xl mx-auto px-4 md:px-8 py-10">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6 border-b pb-2">Update Profile</h2>
        
        <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-8" role="alert">
                <p class="font-medium">Error: <%= error %></p>
            </div>
        <% } %>
        <% if (message) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-8" role="alert">
                <p class="font-medium">Success: <%= message %></p>
            </div>
        <% } %>

        <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-indigo-500">
            <p class="text-gray-600 mb-4">You can only change your Mobile Number and City.</p>
            
            <form method="POST" action="/user/profile" class="space-y-4">
                
                <!-- Name (Read-Only) -->
                <div class="bg-gray-100 p-3 rounded-lg border border-gray-300">
                    <p class="text-xs text-gray-500">Name (Cannot be changed)</p>
                    <p class="font-medium text-gray-800"><%= user.name %></p>
                </div>

                <!-- Email (Read-Only) -->
                <div class="bg-gray-100 p-3 rounded-lg border border-gray-300">
                    <p class="text-xs text-gray-500">Email (Cannot be changed)</p>
                    <p class="font-medium text-gray-800"><%= user.email %></p>
                </div>

                <!-- Mobile Input -->
                <div class="flex items-center border bg-indigo-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-indigo-400 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-phone"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 3.07 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    <input name="mobile" type="text" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="New Mobile Number" value="<%= user.mobile || '' %>" />
                </div>
                
                <!-- City Input -->
                <div class="flex items-center border bg-indigo-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-indigo-400 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-map-pin"><path d="M12 21.7C17.3 17 21 13 21 10.2A7 7 0 0 0 12 3a7 7 0 0 0-9 7.2c0 2.3 3.7 6.3 9 11.5z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <input name="city" type="text" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="New City" value="<%= user.city || '' %>" />
                </div>
                
                <div class="pt-4 flex justify-between gap-4">
                    <a href="/user/dashboard" class="w-1/2 text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2.5 rounded-lg transition">Back</a>
                    <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg transition shadow-md shadow-indigo-200">
                        Update Profile
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>