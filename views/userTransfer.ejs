<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Bank - Fund Transfer</title>

    <link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
        body { font-family: 'Poppins', sans-serif; background: #f8f8fb; }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main class="max-w-xl mx-auto px-4 md:px-8 py-10">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6 border-b pb-2">Fund Transfer (IMPS)</h2>
        
        <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-8" role="alert">
                <p class="font-medium"><%= error %></p>
            </div>
        <% } %>

        <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-blue-500">
            <p class="text-gray-600 mb-4">Available Balance: <strong class="text-blue-600">₹<%= user.balance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></p>
            
            <form method="POST" action="/user/transfer" class="space-y-4">
                <!-- Recipient Account Input -->
                <div class="flex items-center border bg-blue-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-blue-400 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-repeat"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                    <input name="toAccount" type="text" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="Recipient Account Number" required />
                </div>

                <!-- Amount Input -->
                <div class="flex items-center border bg-blue-500/5 border-gray-500/10 rounded-lg pl-3 focus-within:border-blue-400 transition">
                    <span class="text-gray-400 text-lg">₹</span>
                    <input name="amount" type="number" step="0.01" min="0.01" max="<%= user.balance.toFixed(2) %>" class="w-full outline-none bg-transparent py-3 pl-2 text-gray-800" placeholder="Amount to Transfer" required />
                </div>
                
                <!-- PIN Input -->
                <div class="flex items-center border bg-blue-500/5 border-gray-500/10 rounded-lg gap-3 pl-3 focus-within:border-blue-400 transition">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-opacity=".6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="feather feather-key"><path d="M12 11c-2.76 0-5 2.24-5 5s2.24 5 5 5c2.76 0 5-2.24 5-5s-2.24-5-5-5z"></path><path d="M22 2l-7 7m0 0l-7-7m7 7l7-7"></path><circle cx="12" cy="16" r="4"></circle></svg>
                    <input name="pin" type="password" maxlength="6" class="w-full outline-none bg-transparent py-3 text-gray-800" placeholder="Confirm PIN" required />
                </div>
                
                <div class="pt-2 flex justify-between gap-4">
                    <a href="/user/dashboard" class="w-1/2 text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2.5 rounded-lg transition">Cancel</a>
                    <button type="submit" class="w-1/2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition shadow-md shadow-blue-200">
                        Transfer Funds
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>